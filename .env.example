# Copy to .env (repo root) or backend/.env.
# Default: demo mode. Runs fully offline with a deterministic rule-based LLM.
LLM_PROVIDER=demo

# Real model: any OpenAI-compatible endpoint.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Local model via Ollama (OpenAI-compatible API):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1

# Storage (relative to backend/)
# DB_PATH=data/northwind.db
# CHECKPOINT_PATH=data/checkpoints.db
